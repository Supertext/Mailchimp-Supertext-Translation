# Supertext Translation for Mailchimp: environment variables (Railway variables in production).
# Never commit real values.

# Public HTTPS URL of this app. Register APP_URL/oauth/callback as the app's redirect URI in Mailchimp.
APP_URL=https://mailchimp-production-xxxx.up.railway.app

# From Mailchimp → Profile → Extras → Registered apps (Supertext's Mailchimp account).
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=

# Random secret that signs session cookies (default: derived from the client secret).
SESSION_SECRET=

# PostgreSQL for accounts, drafts and jobs (the shared Railway Postgres; the database is created on first start).
# Without it, everything lives in memory only (local development).
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/mailchimp_supertext

# Optional: encrypts stored Mailchimp tokens and Supertext API keys (default: derived from the client secret).
APP_ENCRYPTION_KEY=

# Optional default Supertext API key for accounts that haven't entered their own (the demo account).
# No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate your API key at https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API; requires the Admin role).
SUPERTEXT_API_KEY=

# Optional: how often the Supertext folders are checked, in seconds (default 60; 0 = never).
FOLDER_POLL_SECONDS=60

# Optional: 0 turns the version reports to Supertext's Commando Center off for every account
# (default: each account's setting "Send version information to Supertext", on by default).
SUPERTEXT_VERSION_REPORTS=

# Optional: stand-ins (tests, screenshots) instead of https://api.supertext.com/v1/ and https://login.mailchimp.com.
SUPERTEXT_API_ENDPOINT=
MAILCHIMP_LOGIN_BASE=
